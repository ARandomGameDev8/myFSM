// strings.fsm — the `string` type end to end: a constant string, compile-time
// concatenation, a runtime string variable, temps, escapes, and comparisons
// driving transitions.
const string greeting = "hello";
const string joined   = greeting + ", world";   // folded at compile time

var string  label;                              // runtime string: binding slot 0
var Object3D target;

State Idle {
    Actions {
        temp string tag    = "idle";
        temp string banner = joined + "!";      // concatenation evaluated at runtime
        Start {
            label = tag;                        // runs once, on entry
        }
        Update {
            if (banner == "hello, world!") {
                temp string esc = "a\tb\nc\\d\"e";  // escapes survive the round trip
                label = esc;
            }
        }
    }
    Traversals {
        if (label == greeting) { goto Run; }
        goto Idle;
    }
}

State Run {
    Actions {
        Start {
            label = "run";
        }
        Update { }
    }
    Traversals {
        if (label != "run") { goto Idle; }
        goto Run;
    }
}

@ENTRY Idle
