// Action logic belongs inside Start{} or Update{}; only 'temp' declarations may
// sit directly in the Actions body.
var Object3D self;
var Object3D target;
var NavMeshAgent agent;
State A {
    Actions {
        temp Vector3 dir = directionTo(self, target);
        moveTowards(agent, dir, 2.0f); // ERROR: action logic outside the phases
        Start { }
        Update { }
    }
    Traversals {
        goto A;
    }
}
@ENTRY A
