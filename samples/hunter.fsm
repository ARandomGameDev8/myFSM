// samples/hunter.fsm — a classic Hunt / Flee / Lost AI.
//
// Shows: if / else-if / else, block-scoped temps (each one lives in the {}
// body that declares it — including the Start{} and Update{} bodies), vector
// math (component-wise +, scalar *), the && operator, and multiple Tier 3 calls
// that drive an object passed as their first argument (moveTowards drives the
// hunter's movement, lookAt its facing).

const float attackRange = 2.5f;
const float fleeBelow   = 25.0f;

var Object3D     player;
var Object3D     hunter;
var NavMeshAgent agent;
var float        health;
var bool         playerVisible;

State Hunt {
    temp float lastSeenDist = 999.0f;     // State body: persists across ticks
    Actions {
        temp float dist = getDistanceTo(hunter, player);  // Actions body: both phases see it
        Start {
            lookAt(hunter, player);       // snap to the player the moment we spot it
        }
        Update {
            lastSeenDist = dist;
            if (dist <= attackRange) {
                stopMovement(agent);
                lookAt(hunter, player);
            } else {
                temp Vector3 toPlayer = directionTo(hunter, player);  // dies with this else
                moveTowards(agent, toPlayer, 3.5f);
            }
        }
    }
    Traversals {
        if (health < fleeBelow) { goto Flee; }
        if (!playerVisible)    { goto Lost; }
        goto Hunt;
    }
}

State Flee {
    Actions {
        Start { }                         // fleeing needs no entry setup
        Update {
            // The flee direction is recomputed every tick (the player moves),
            // then the chase is restated: moveTowards is the one movement
            // call — its speed argument is absolute (base speed was the old
            // sprintTowards's job, times its multiplier).
            temp Vector3 away = getFleeDirection(getPosition(hunter), getPosition(player));
            moveTowards(agent, away, 5.25f);    // re-steered every tick
        }
    }
    Traversals {
        if (health >= fleeBelow && playerVisible) { goto Hunt; }
        goto Flee;
    }
}

State Lost {
    temp int ticks = 0;
    Actions {
        temp Vector3 dest = getWanderVector(getPosition(hunter), 5.0f);
        Start {
            moveTowards(agent, dest, 2.0f);     // pick a wander target once, on entry
        }
        Update {
            ticks = ticks + 1;                  // count the ticks spent lost
        }
    }
    Traversals {
        if (playerVisible) { goto Hunt; }
        goto Lost;
    }
}

@ENTRY Hunt
