// samples/patrol.fsm — a patrol AI: walks A -> B -> A forever,
// pausing a few ticks at each waypoint.
//
// Shows: the mandatory Start{}/Update{} phase blocks (issue the move order
// once on entry, then poll), state-level temps (tick counter), Tier 3
// navigation calls, a 4-state cycle, and goto to states declared later.

const int pauseTicks = 3;

var NavMeshAgent agent;
var Object3D     waypointA;
var Object3D     waypointB;

State GoToA {
    Actions {
        Start {
            goTo(agent, waypointA);   // Tier 3: one CALL; 'agent' must be a variable
        }
        Update { }                    // nothing per tick: Traversals polls arrival
    }
    Traversals {
        if (hasReachedDestination(agent, waypointA)) { goto PauseAtA; }
        goto GoToA;                   // self-loop until the destination is reached
    }
}

State PauseAtA {
    temp int ticks = 0;               // created when PauseAtA is entered, dies on exit
    Actions {
        Start {
            stopMovement(agent);      // halt once, on entry
        }
        Update {
            ticks = ticks + 1;        // count the pause ticks
        }
    }
    Traversals {
        if (ticks >= pauseTicks) { goto GoToB; }
        goto PauseAtA;
    }
}

State GoToB {
    Actions {
        Start {
            goTo(agent, waypointB);
        }
        Update { }
    }
    Traversals {
        if (hasReachedDestination(agent, waypointB)) { goto PauseAtB; }
        goto GoToB;
    }
}

State PauseAtB {
    temp int ticks = 0;
    Actions {
        Start {
            stopMovement(agent);
        }
        Update {
            ticks = ticks + 1;
        }
    }
    Traversals {
        if (ticks >= pauseTicks) { goto GoToA; }   // back to the start
        goto PauseAtB;
    }
}

@ENTRY GoToA
