<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>RPGCharacterStatsSandbox</AssemblyName>
    <NoWarn>CS0414;CS0649;CS0067</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/**/*.cs" />
    <Compile Include="../CharacterStats/**/*.cs" />
    <Compile Include="../GameplayStats/**/*.cs" />
    <Compile Include="../Definitions/**/*.cs" />
    <Compile Include="../Runtime/**/*.cs" />
    <Compile Include="../UI/**/*.cs" />
    <Compile Include="../Samples/OrcWarriorFSM.cs" />
    <Compile Include="UnityEngineStubs.cs" />
    <Compile Include="RPGCharacterStatsTests.cs" />
  </ItemGroup>
</Project>
