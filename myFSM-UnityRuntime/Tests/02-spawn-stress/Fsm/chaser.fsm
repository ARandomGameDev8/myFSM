// Test 02 — spawn-stress chaser: one AI per spawned cube, hunting the player.
//
// The point of this module is to be tiny, so the spawn-stress test measures the
// RUNTIME (N AIs ticking, each posting a goal every tick), not the FSM.
//
// moveTowards takes a destination: given an OBJECT it re-reads that object every
// tick, so it tracks a target that moves; given a point (getPosition(...)) it is
// re-posted here every tick, which tracks just as well and keeps the module tiny.
// Speed is explicit (the runtime uses it directly), which is what makes the
// stress numbers comparable between runs.
//
// The spawned cube carries a dynamic Rigidbody, so the runtime moves it exactly
// like the plain follower script, once per physics step from FixedUpdate:
//   rb.MovePosition(rb.position + (dest - rb.position).normalized * chaseSpeed
//                   * Time.fixedDeltaTime)
// Nothing else is written to the cube — no velocity, no clamping, no stop
// distance — Unity moves it and resolves the contacts. The direction is the
// full 3D direction to the destination; gravity keeps pulling the cube down in
// the same physics step.

// Faster than the player (PlayerController.speed = 8): a crowd that is slower than
// what it chases never catches up, and the ones at the back stay jammed where they
// were - which looks like everything being stuck to one spot.
const float chaseSpeed = 10.0f;

var Object3D self;    // slot 0 - the spawned cube
var Object3D player;  // slot 1 - the WASD target (same type: bind both by hand)

State Chase {
    Actions {
        Start { }
        Update {
            moveTowards(self, getPosition(player), chaseSpeed);
        }
    }
    Traversals {
        goto Chase;
    }
}

@ENTRY Chase
